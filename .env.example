# ─────────────────────────────────────────────────────────────
# Atlas — variables d'environnement (exemple)
# Copier en `.env` et renseigner les valeurs. NE JAMAIS committer `.env`.
# ─────────────────────────────────────────────────────────────

# Base de données PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/atlas?schema=public"

# URL publique du site (utilisée pour le SEO : canonical, sitemap, OG…)
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# Authentification (NextAuth / Auth.js v5)
# Générer un secret : `openssl rand -base64 32`
AUTH_SECRET="changeme-generate-a-strong-secret"
AUTH_TRUST_HOST="true"

# Administrateur principal : l'utilisateur dont l'e-mail Google correspond
# se voit attribuer automatiquement le rôle ADMIN à la connexion.
ADMIN_EMAIL=anouarelbardaoui36@gmail.com

# Fournisseur OAuth Google (optionnel)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Google (mesure & monétisation — Phase 4)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_ADSENSE_CLIENT=""
NEXT_PUBLIC_GSC_VERIFICATION=""
